# EDEN UI REALISM ENGINE - Environment Variables
# ===============================================

# HuggingFace Token (required for some models)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# AI/LLM API Keys (optional but recommended for chat features)
# These enable the natural language chat assistant
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ComfyUI Integration (optional)
# Path to your ComfyUI installation
COMFYUI_PATH=/path/to/ComfyUI
COMFYUI_PORT=8188

# Development Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./eden_ui.db
REDIS_URL=redis://localhost:6379/0

# GPU Settings
CUDA_VISIBLE_DEVICES=0
MIXED_PRECISION=fp16
